# API base URL (use /api with Vite proxy in dev, or full URL in production)
VITE_API_BASE_URL=/api

# Use the Spring Boot API. Set true only for isolated mock previews.
VITE_USE_MOCK_API=false

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# Optional public contact email. Leave empty to use the support form.
VITE_CONTACT_EMAIL=

# Optional; Stripe is disabled until this is configured.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional; must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=
